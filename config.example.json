    "timeout_sec": 15.0,
    "max_retries": 2,
    "batch_size": 10,
    "custom_headers": {},
    "extra_body": {}
  },
  "jev": {
    "enabled": true,
    "base_url": "https://openrouter.ai/api/alpha/decisions",
    "api_key": "",
    "model": "typesafe/jev-1.14",
    "protocol": "auto",
    "custom_headers": {},
    "timeout_sec": 1.5,
    "reply_threshold": 0.65,
    "high_effort_threshold": 0.6

    "timeout_sec": 15.0,
    "max_size": 1280,
    "reasoning_effort": "",
    "custom_headers": {},
    "extra_body": {}
  },
  "llm": {
    "base_url": "https://api.openai.com/v1",
    "api_key": "",
    "model": "gpt-4o",
    "fallback_model": "",

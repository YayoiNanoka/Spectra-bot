{
  "db": {
    "path": "data/bot.db",
    "message_retention_days": 7
  },
  "access": {
    "admin_users": [],
    "ignored_users": [
      "2854196310"
    ],
    "group_mode": "blacklist",
    "group_blacklist": [],
    "group_whitelist": [],
    "private_mode": "blacklist",
    "private_blacklist": [],
    "private_whitelist": []
  },
  "napcat": {
    "host": "0.0.0.0",
    "port": 6199,
    "access_token": "",
    "bot_name": "Spectra",
    "segmented_reply": {
      "enable": true,
      "interval_method": "random",
      "interval": "1.5,3.5",
      "log_base": 2.6,
      "words_count_threshold": 150,
      "split_mode": "regex",
      "regex": ".*?[。？！~…]+|.+$",
      "split_words": [
        "。",
        "？",
        "！",
        "~",
        "…"
      ],
      "content_cleanup_rule": ""
    },
    "forward_threshold": 1500
  },
  "vision": {
    "enabled": true,
    "base_url": "https://api.openai.com/v1",
    "api_key": "",
    "model": "gpt-4o-mini",
    "prompt": "请用简短中文（30字以内）描述这张图片或表情包的画面内容、图中文字和情绪。",
    "timeout_sec": 15.0,
    "max_size": 1280,
    "reasoning_effort": "",
    "custom_headers": {},
    "extra_body": {}
  },
  "llm": {
    "base_url": "https://api.openai.com/v1",
    "api_key": "",
    "model": "gpt-4o",
    "fallback_model": "",
    "default_effort": "",
    "high_effort": "high",
    "timeout_sec": 60.0,
    "max_retries": 5,
    "max_tool_steps": 10,
    "custom_headers": {},
    "extra_body": {}
  },
  "jev": {
    "enabled": true,
    "base_url": "https://openrouter.ai/api/alpha/decisions",
    "api_key": "",
    "model": "typesafe/jev-1.14",
    "protocol": "auto",
    "custom_headers": {},
    "timeout_sec": 1.5,
    "reply_threshold": 0.65,
    "high_effort_threshold": 0.6
  },
  "gate": {
    "proactive_mode": "on",
    "private_debounce_sec": 1.5,
    "group_debounce_sec": 2.5,
    "max_batch_wait_sec": 6.0,
    "proactive_cooldown_sec": 60.0,
    "proactive_max_per_hour": 15,
    "hot_window_sec": 30.0,
    "state_message_limit": 10,
    "active_reply": {
      "method": "possibility_reply",
      "possibility_reply": 0.1,
      "whitelist": []
    }
  },
  "session": {
    "prompts_dir": "prompts",
    "window_max_messages": 60,
    "window_keep_messages": 30,
    "timezone": "Asia/Shanghai"
  },
  "trace": {
    "enabled": true,
    "path": "data/traces.jsonl"
  }
}

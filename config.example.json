{
  "db": {
    "path": "data/bot.db",
    "message_retention_days": 7
  },
  "access": {
    "admin_users": [],
    "ignored_users": [
      "2854196310"
    ],
    "group_mode": "blacklist",
    "group_blacklist": [],
